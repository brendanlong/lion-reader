-- Downloaded article bodies (sanitized HTML), apart from entry so that the body
-- downloader, which runs outside the sync lock, can never touch read/starred
-- state. An empty body means "downloaded, nothing to show" (or no longer
-- visible), so it isn't asked for again. A body behind its entry's
-- body_version (an edit) is out of date: it's shown until the new one replaces
-- it, so an open article never goes blank and reloads.
CREATE TABLE entry_body (
  entry_id TEXT NOT NULL PRIMARY KEY,
  content TEXT NOT NULL,
  size INTEGER NOT NULL,
  downloaded_at INTEGER NOT NULL,
  -- The body as plain text, only until a trigger moves it into the search
  -- index (SearchIndex.kt), which empties it.
  search_text TEXT NOT NULL,
  -- The entry's body_version it was downloaded at. Last, as the migration adds
  -- it (4.sqm).
  body_version INTEGER NOT NULL DEFAULT 0
);

-- Stores a body fetched at the entry's :bodyVersion, in place of any older one,
-- only while the entry is still on the device at that version: a download
-- racing a deletion or an edit can't leave a missing or stale body behind
-- (pruneOrphans catches the rest).
putIfCurrent:
INSERT OR REPLACE INTO entry_body(entry_id, content, size, downloaded_at, search_text, body_version)
SELECT :entryId, :content, :size, :downloadedAt, :searchText, :bodyVersion
WHERE EXISTS (SELECT 1 FROM entry WHERE id = :entryId AND body_version = :bodyVersion);

deleteForEntry:
DELETE FROM entry_body WHERE entry_id = ?;

-- Comparisons stay in SQLite: reading a body out can take more than Android's
-- cursor window holds.
matches:
SELECT count(*) FROM entry_body WHERE entry_id = :entryId AND content = :content;

existsCurrent:
SELECT count(*) FROM entry e JOIN entry_body b ON b.entry_id = e.id
WHERE e.id = ? AND b.body_version = e.body_version;

-- Bodies whose entry is gone (retention, deletions, unsubscribes).
pruneOrphans:
DELETE FROM entry_body WHERE entry_id NOT IN (SELECT id FROM entry);

deleteAll:
DELETE FROM entry_body;

size:
SELECT size FROM entry_body WHERE entry_id = ?;

totalSize:
SELECT COALESCE(SUM(size), 0) FROM entry_body;

-- Budget eviction order: read before unread, oldest first; starred and saved
-- bodies, and those of collections' articles, are kept (selectMissingContent
-- would download them again). Entries opened since :openedSince go last: opening one marks
-- it read, and it may still be on screen.
evictionCandidates:
SELECT b.entry_id, b.size
FROM entry_body b
JOIN entry_view v ON v.id = b.entry_id
WHERE v.type != 'saved' AND v.effective_starred = 0
  AND v.id NOT IN (SELECT entry_id FROM collection_entry)
ORDER BY COALESCE(v.last_opened_at >= :openedSince, 0), v.effective_read DESC, v.sort_at ASC;
