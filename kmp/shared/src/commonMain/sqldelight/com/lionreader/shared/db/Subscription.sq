CREATE TABLE subscription (
  id TEXT NOT NULL PRIMARY KEY,
  feed_id TEXT,
  type TEXT NOT NULL,
  title TEXT,
  url TEXT,
  site_url TEXT,
  unread_count INTEGER NOT NULL,
  fetch_full_content INTEGER NOT NULL
);

CREATE TABLE tag (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  color TEXT,
  unread_count INTEGER NOT NULL
);

CREATE TABLE subscription_tag (
  subscription_id TEXT NOT NULL,
  tag_id TEXT NOT NULL,
  PRIMARY KEY (subscription_id, tag_id)
);

-- Server-reported absolute unread counts for the top-level lists
-- ('all', 'starred', 'saved', 'uncategorized').
CREATE TABLE list_count (
  list TEXT NOT NULL PRIMARY KEY,
  unread INTEGER NOT NULL
);

upsertSubscription:
INSERT OR REPLACE INTO subscription(id, feed_id, type, title, url, site_url, unread_count, fetch_full_content)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateSubscriptionTitle:
UPDATE subscription SET title = COALESCE(?, title) WHERE id = ?;

setSubscriptionUnread:
UPDATE subscription SET unread_count = ? WHERE id = ?;

deleteSubscription:
DELETE FROM subscription WHERE id = ?;

deleteAllSubscriptions:
DELETE FROM subscription;

selectSubscriptions:
SELECT * FROM subscription ORDER BY title COLLATE NOCASE;

selectSubscription:
SELECT * FROM subscription WHERE id = ?;

insertTagIgnore:
INSERT OR IGNORE INTO tag(id, name, color, unread_count) VALUES (?, ?, ?, 0);

updateTag:
UPDATE tag SET name = ?, color = ? WHERE id = ?;

setTagUnread:
UPDATE tag SET unread_count = ? WHERE id = ?;

deleteTag:
DELETE FROM tag WHERE id = ?;

deleteAllTags:
DELETE FROM tag;

selectTags:
SELECT * FROM tag ORDER BY name COLLATE NOCASE;

selectTag:
SELECT * FROM tag WHERE id = ?;

clearSubscriptionTags:
DELETE FROM subscription_tag WHERE subscription_id = ?;

deleteTagLinks:
DELETE FROM subscription_tag WHERE tag_id = ?;

deleteAllSubscriptionTags:
DELETE FROM subscription_tag;

addSubscriptionTag:
INSERT OR IGNORE INTO subscription_tag(subscription_id, tag_id) VALUES (?, ?);

selectSubscriptionTags:
SELECT * FROM subscription_tag;

setListCount:
INSERT OR REPLACE INTO list_count(list, unread) VALUES (?, ?);

selectListCounts:
SELECT * FROM list_count;

deleteAllListCounts:
DELETE FROM list_count;
