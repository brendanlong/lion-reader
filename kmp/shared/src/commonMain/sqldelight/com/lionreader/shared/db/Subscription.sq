CREATE TABLE subscription (
  id TEXT NOT NULL PRIMARY KEY,
  -- The custom title if there is one, else original_title.
  title TEXT,
  url TEXT,
  -- The feed's own title, which clearing the custom title goes back to.
  original_title TEXT
);

CREATE TABLE tag (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  color TEXT
);

CREATE TABLE subscription_tag (
  subscription_id TEXT NOT NULL,
  tag_id TEXT NOT NULL,
  PRIMARY KEY (subscription_id, tag_id)
);

upsertSubscription:
INSERT OR REPLACE INTO subscription(id, title, url, original_title) VALUES (?, ?, ?, ?);

-- A null custom title means there is none.
updateSubscriptionTitle:
UPDATE subscription SET title = COALESCE(:customTitle, original_title) WHERE id = :id;

deleteSubscription:
DELETE FROM subscription WHERE id = ?;

deleteAllSubscriptions:
DELETE FROM subscription;

selectSubscriptions:
SELECT * FROM subscription ORDER BY title COLLATE NOCASE;

insertTagIgnore:
INSERT OR IGNORE INTO tag(id, name, color) VALUES (?, ?, ?);

updateTag:
UPDATE tag SET name = ?, color = ? WHERE id = ?;

deleteTag:
DELETE FROM tag WHERE id = ?;

deleteAllTags:
DELETE FROM tag;

selectTags:
SELECT * FROM tag ORDER BY name COLLATE NOCASE;

clearSubscriptionTags:
DELETE FROM subscription_tag WHERE subscription_id = ?;

deleteTagLinks:
DELETE FROM subscription_tag WHERE tag_id = ?;

deleteAllSubscriptionTags:
DELETE FROM subscription_tag;

addSubscriptionTag:
INSERT OR IGNORE INTO subscription_tag(subscription_id, tag_id) VALUES (?, ?);

selectSubscriptionTags:
SELECT * FROM subscription_tag;
