-- Entries in the offline window: metadata and the last read/starred state the
-- server reported. The user's unsent changes live in outbox_state and win on
-- display (see entry_view); article bodies live in entry_body.
CREATE TABLE entry (
  id TEXT NOT NULL PRIMARY KEY,
  -- The server's origin subscription (its `subscriptionId`), as it sent it.
  -- Lists go by subscription_entry; this says whose title feed_title follows
  -- (refreshFeedTitles).
  subscription_id TEXT,
  -- The server's entry type ('web', 'email', 'saved'…), as it sent it. Only
  -- the shown and searched source go by it (Reader's entrySource,
  -- SearchIndex.kt); lists don't: Saved is a subscription like the others.
  type TEXT NOT NULL,
  url TEXT,
  title TEXT,
  author TEXT,
  summary TEXT,
  site_name TEXT,
  feed_title TEXT,
  published_at INTEGER,
  fetched_at INTEGER NOT NULL,
  -- COALESCE(published_at, fetched_at), the server's timeline order.
  sort_at INTEGER NOT NULL,
  read INTEGER NOT NULL,
  starred INTEGER NOT NULL,
  last_opened_at INTEGER,
  -- From body_version_seq: new on insert and whenever the server reports the
  -- entry edited, so a body downloaded before an edit, or before the entry
  -- was deleted and added again, is out of date and never replaces a newer
  -- one (SyncWriter.putBody).
  body_version INTEGER NOT NULL,
  -- When read state last changed, as the server last reported it (Recently
  -- Read's order); null if it never has.
  read_changed_at INTEGER,
  -- The user's score for it, as the server last reported it (#2064): what
  -- selectTimelineByScore orders by, higher first. Null if it has none. Last,
  -- where 10.sqm added it, so entry_view's columns are in the same order on
  -- every device.
  score REAL
);

-- Never reset (not even by clearSynced), so no entry gets back a
-- version an in-flight download started at.
CREATE TABLE body_version_seq (
  value INTEGER NOT NULL
);

INSERT INTO body_version_seq(value) VALUES (0);

CREATE INDEX entry_timeline ON entry(sort_at DESC, id DESC);

CREATE VIEW entry_view AS
SELECT
  e.*,
  COALESCE(r.value, e.read) AS effective_read,
  COALESCE(s.value, e.starred) AS effective_starred,
  -- An unsent read change counts once it's later than the server's.
  CASE
    WHEN r.changed_at IS NOT NULL AND (e.read_changed_at IS NULL OR r.changed_at > e.read_changed_at)
    THEN r.changed_at
    ELSE e.read_changed_at
  END AS effective_read_changed_at
FROM entry e
LEFT JOIN outbox_state r ON r.entry_id = e.id AND r.field = 'read'
LEFT JOIN outbox_state s ON s.entry_id = e.id AND s.field = 'starred';

-- Upsert as insert-or-ignore + update: minSdk 26 ships SQLite 3.18, which
-- predates ON CONFLICT DO UPDATE (and INSERT OR REPLACE would drop the body).
insertIgnore {
  UPDATE body_version_seq SET value = value + 1;
  INSERT OR IGNORE INTO entry(id, type, fetched_at, sort_at, read, starred, body_version)
  VALUES (:id, :type, :fetchedAt, :sortAt, :read, :starred, (SELECT value FROM body_version_seq));
}

updateAll:
UPDATE entry SET
  subscription_id = ?, type = ?, url = ?, title = ?, author = ?,
    summary = ?, site_name = ?, feed_title = ?, published_at = ?, fetched_at = ?, sort_at = ?,
  read = ?, starred = ?, read_changed_at = COALESCE(?, read_changed_at)
WHERE id = ?;

updateMetadata:
UPDATE entry SET title = ?, author = ?, summary = ?, url = ?, published_at = ?,
  sort_at = COALESCE(?, fetched_at)
WHERE id = ?;

-- The server sends an entry's feed_title as its subscription's title (custom
-- if set), but a rename doesn't re-send the entries, so they follow it here.
-- Saved isn't in subscription, so its entries keep theirs.
refreshFeedTitles:
UPDATE entry SET feed_title = (SELECT title FROM subscription WHERE id = entry.subscription_id)
WHERE subscription_id IN (SELECT id FROM subscription)
  AND feed_title IS NOT (SELECT title FROM subscription WHERE id = entry.subscription_id);

refreshFeedTitlesFor:
UPDATE entry SET feed_title = (SELECT title FROM subscription WHERE id = :subscriptionId)
-- Through subscription_entry for its index (an origin is always a membership).
WHERE id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId)
  AND subscription_id = :subscriptionId
  AND EXISTS (SELECT 1 FROM subscription WHERE id = :subscriptionId)
  AND feed_title IS NOT (SELECT title FROM subscription WHERE id = :subscriptionId);

updateServerState:
UPDATE entry SET read = ?, starred = ?, read_changed_at = COALESCE(?, read_changed_at) WHERE id = ?;

updateScore:
UPDATE entry SET score = ? WHERE id = ?;

markOpened:
UPDATE entry SET last_opened_at = ? WHERE id = ?;

exists:
SELECT count(*) FROM entry WHERE id = ?;

deleteById:
DELETE FROM entry WHERE id = ?;

deleteAll:
DELETE FROM entry;

-- Visibility after an unsubscribe: the server keeps an entry visible while
-- it's starred or in another subscription.
deleteUnstarredOnlyIn:
DELETE FROM entry
WHERE id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId)
  AND id NOT IN (SELECT entry_id FROM subscription_entry WHERE subscription_id != :subscriptionId)
  AND id NOT IN (SELECT id FROM entry_view WHERE effective_starred = 1);

selectById:
SELECT v.*, s.html AS ai_summary
FROM entry_view v
LEFT JOIN entry_summary s ON s.entry_id = v.id
WHERE v.id = ?;

-- Timeline for one list. Each filter argument is ignored when null. A
-- subscription (Saved included), a tag and Uncategorized list their
-- subscriptions' members (subscription_entry). Uncategorized is the untagged
-- subscriptions on the device, all of them active.
selectTimeline:
SELECT id, url, title, author, summary, type, site_name, feed_title,
  sort_at, effective_read, effective_starred
FROM entry_view
WHERE (:subscriptionId IS NULL
    OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
  AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
  AND (:starredOnly = 0 OR effective_starred = 1 OR id IN :keepIds)
  AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription s ON s.id = se.subscription_id
      WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)))
  AND (:unreadOnly = 0 OR effective_read = 0 OR id IN :keepIds)
ORDER BY sort_at DESC, id DESC
LIMIT :limit;

-- selectTimeline oldest first, with the same filters (keep them in step). Not
-- one query with a CASE in its ORDER BY: that can't use entry_timeline, so it
-- sorts every matching entry instead of reading the first page off the index.
selectTimelineOldestFirst:
SELECT id, url, title, author, summary, type, site_name, feed_title,
  sort_at, effective_read, effective_starred
FROM entry_view
WHERE (:subscriptionId IS NULL
    OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
  AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
  AND (:starredOnly = 0 OR effective_starred = 1 OR id IN :keepIds)
  AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription s ON s.id = se.subscription_id
      WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)))
  AND (:unreadOnly = 0 OR effective_read = 0 OR id IN :keepIds)
ORDER BY sort_at ASC, id ASC
LIMIT :limit;

-- selectTimeline by score (#2064), with the same filters (keep them in step),
-- in the server's order: scored entries first, highest first (or lowest, with
-- ties by date flipped too), then the unscored, newest first either way. This
-- one sorts every matching entry (no index reads both ranges in both
-- directions), which retention keeps to a few thousand.
selectTimelineByScore:
SELECT id, url, title, author, summary, type, site_name, feed_title,
  sort_at, effective_read, effective_starred
FROM entry_view
WHERE (:subscriptionId IS NULL
    OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
  AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
  AND (:starredOnly = 0 OR effective_starred = 1 OR id IN :keepIds)
  AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription s ON s.id = se.subscription_id
      WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)))
  AND (:unreadOnly = 0 OR effective_read = 0 OR id IN :keepIds)
ORDER BY score IS NULL,
  CASE WHEN :lowestFirst = 1 THEN score ELSE -score END,
  CASE WHEN score IS NOT NULL AND :lowestFirst = 1 THEN sort_at ELSE -sort_at END,
  CASE WHEN score IS NOT NULL AND :lowestFirst = 1 THEN id END ASC,
  id DESC
LIMIT :limit;

-- One subscription's list (a collection's) by position in it (#2064), in the
-- server's order: positioned entries first, lowest first (or highest, with
-- ties by date flipped too), then the rest, newest first either way.
selectTimelineByPosition:
SELECT v.id, v.url, v.title, v.author, v.summary, v.type, v.site_name, v.feed_title,
  v.sort_at, v.effective_read, v.effective_starred
FROM entry_view v
JOIN subscription_entry se ON se.entry_id = v.id AND se.subscription_id = :subscriptionId
WHERE :unreadOnly = 0 OR v.effective_read = 0 OR v.id IN :keepIds
ORDER BY se.position IS NULL,
  CASE WHEN :lastFirst = 1 THEN -se.position ELSE se.position END,
  CASE WHEN se.position IS NOT NULL AND :lastFirst = 0 THEN v.sort_at ELSE -v.sort_at END,
  CASE WHEN se.position IS NOT NULL AND :lastFirst = 0 THEN v.id END ASC,
  v.id DESC
LIMIT :limit;

-- Which orders besides date a list can be shown in (#2064), with
-- selectTimeline's filters (keep them in step), as the server's `sortable`:
-- score if any of its entries has one, position if any of :subscriptionId's
-- members has one in it.
sortable:
SELECT
  EXISTS (SELECT 1 FROM entry_view
    WHERE score IS NOT NULL
      AND (:subscriptionId IS NULL
        OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
      AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
          JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
      AND (:starredOnly = 0 OR effective_starred = 1 OR id IN :keepIds)
      AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
          JOIN subscription s ON s.id = se.subscription_id
          WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)))
      AND (:unreadOnly = 0 OR effective_read = 0 OR id IN :keepIds)
  ) AS by_score,
  EXISTS (SELECT 1 FROM entry_view v
    JOIN subscription_entry se ON se.entry_id = v.id AND se.subscription_id = :subscriptionId
    WHERE se.position IS NOT NULL
      AND (:unreadOnly = 0 OR v.effective_read = 0 OR v.id IN :keepIds)
  ) AS by_position;

-- How many entries selectTimeline would return with no limit, with the same
-- filters (keep them in step), for the list's scrollbar.
countTimeline:
SELECT count(*)
FROM entry_view
WHERE (:subscriptionId IS NULL
    OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
  AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
  AND (:starredOnly = 0 OR effective_starred = 1 OR id IN :keepIds)
  AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription s ON s.id = se.subscription_id
      WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)))
  AND (:unreadOnly = 0 OR effective_read = 0 OR id IN :keepIds);

bumpBodyVersion {
  UPDATE body_version_seq SET value = value + 1;
  UPDATE entry SET body_version = (SELECT value FROM body_version_seq) WHERE id = :id;
}

-- Recently Read: entries whose read state changed, latest change first (the
-- web's order), whichever side made it.
selectRecentlyRead:
SELECT id, url, title, author, summary, type, site_name, feed_title,
  sort_at, effective_read, effective_starred
FROM entry_view
WHERE effective_read_changed_at IS NOT NULL
ORDER BY effective_read_changed_at DESC, id DESC
LIMIT :limit;

selectRecentlyReadOldestFirst:
SELECT id, url, title, author, summary, type, site_name, feed_title,
  sort_at, effective_read, effective_starred
FROM entry_view
WHERE effective_read_changed_at IS NOT NULL
ORDER BY effective_read_changed_at ASC, id ASC
LIMIT :limit;

countRecentlyRead:
SELECT count(*) FROM entry_view WHERE effective_read_changed_at IS NOT NULL;

bodyVersion:
SELECT body_version FROM entry WHERE id = ?;

-- Entries without a body worth keeping offline, most important first, with
-- what ranks them for the content budget (SyncWriter.BodyRank, whose order
-- this is).
selectMissingContent:
SELECT id, body_version,
  effective_starred = 1 OR id IN (SELECT entry_id FROM kept_entry) AS kept,
  COALESCE(last_opened_at >= :openedSince, 0) AS opened,
  effective_read, sort_at
FROM entry_view
WHERE id NOT IN (SELECT entry_id FROM entry_body)
  AND (effective_read = 0 OR effective_starred = 1 OR id IN (SELECT entry_id FROM kept_entry))
ORDER BY kept DESC, opened DESC, effective_read ASC, sort_at DESC, id DESC
LIMIT :limit;

-- Entries whose body an edit made out of date, newest first.
selectOutdatedBodies:
SELECT e.id, e.body_version FROM entry e
JOIN entry_body b ON b.entry_id = e.id
WHERE b.body_version < e.body_version
ORDER BY e.sort_at DESC, e.id DESC
LIMIT ?;

unreadIdsInScope:
SELECT id FROM entry_view
WHERE effective_read = 0
  AND (:recentlyReadOnly = 0 OR effective_read_changed_at IS NOT NULL)
  AND (:subscriptionId IS NULL
    OR id IN (SELECT entry_id FROM subscription_entry WHERE subscription_id = :subscriptionId))
  AND (:tagId IS NULL OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription_tag st ON st.subscription_id = se.subscription_id WHERE st.tag_id = :tagId))
  AND (:starredOnly = 0 OR effective_starred = 1)
  AND (:uncategorizedOnly = 0 OR id IN (SELECT se.entry_id FROM subscription_entry se
      JOIN subscription s ON s.id = se.subscription_id
      WHERE s.id NOT IN (SELECT subscription_id FROM subscription_tag)));

-- Unread counts come from the device's entries, not the server (Reader.navigation).
unreadTotals:
SELECT
  COALESCE(SUM(effective_read = 0), 0) AS all_unread,
  COALESCE(SUM(effective_read = 0 AND effective_starred = 1), 0) AS starred_unread
FROM entry_view;

-- Each subscription (Saved included) counts its members.
unreadBySubscription:
SELECT se.subscription_id, count(*) AS unread
FROM subscription_entry se
JOIN entry_view v ON v.id = se.entry_id
WHERE v.effective_read = 0
GROUP BY se.subscription_id;

-- An entry in two subscriptions of one tag counts once toward it, as on the
-- server.
unreadByTag:
SELECT st.tag_id, count(DISTINCT v.id) AS unread
FROM entry_view v
JOIN subscription_entry se ON se.entry_id = v.id
JOIN subscription_tag st ON st.subscription_id = se.subscription_id
WHERE v.effective_read = 0
GROUP BY st.tag_id;

-- Retention: drop entries outside the window unless starred, saved, in a
-- collection (kept_entry), read (or unread) within it (Recently Read), or with
-- an unsent change.
evictOutsideWindow:
DELETE FROM entry
WHERE sort_at < :windowStart
  AND id NOT IN (SELECT entry_id FROM kept_entry)
  AND id NOT IN (SELECT id FROM entry_view WHERE effective_starred = 1)
  AND id NOT IN (SELECT id FROM entry_view WHERE effective_read_changed_at >= :windowStart)
  AND id NOT IN (SELECT entry_id FROM outbox_state);

-- Retention: keep at most N read entries, newest (published or read) first
-- (same exemptions).
evictBeyondCount:
DELETE FROM entry
WHERE id IN (
  SELECT id FROM entry_view
  WHERE effective_starred = 0 AND effective_read = 1
    AND id NOT IN (SELECT entry_id FROM outbox_state)
    AND id NOT IN (SELECT entry_id FROM kept_entry)
  ORDER BY MAX(sort_at, COALESCE(effective_read_changed_at, 0)) DESC
  LIMIT -1 OFFSET ?
);
