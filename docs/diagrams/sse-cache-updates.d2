# SSE Event Flow and Cache Update Architecture
#
# This diagram shows how events flow from backend origins through Redis pub/sub
# to the SSE endpoint, and how the frontend handles them to update caches.

direction: down

# ==============================================================================
# EVENT SOURCES (Backend)
# ==============================================================================

event-sources: Event Sources {
  style.fill: "#f0f9ff"

  entry-processor: Entry Processor {
    style.fill: "#dbeafe"
    tooltip: "src/server/feed/entry-processor.ts"

    new-entry-web: publishFeedEvent(new_entry, "web")
    entry-updated: publishFeedEvent(entry_updated)
  }

  email-processor: Email Inbound {
    style.fill: "#dbeafe"
    tooltip: "src/server/email/process-inbound.ts"

    new-entry-email: publishUserEvent(new_entry, "email")
  }

  saved-service: Saved Articles Service {
    style.fill: "#dbeafe"
    tooltip: "src/server/services/saved.ts + routers/saved.ts"

    new-saved: publishUserEvent(new_entry, "saved")
    saved-updated: publishUserEvent(entry_updated, "saved")
  }

  subscriptions-service: Subscriptions Service {
    style.fill: "#e0e7ff"
    tooltip: "src/server/services/subscribe.ts + subscription-updates.ts"

    sub-created: publishUserEvent(subscription_created)
    sub-deleted: publishUserEvent(subscription_deleted)
  }

  job-handlers: Background Jobs {
    style.fill: "#e0e7ff"
    tooltip: "src/server/services/imports.ts"

    import-sub-created: publishUserEvent(subscription_created) // OPML import
    import-progress: publishUserEvent(import_progress)
    import-completed: publishUserEvent(import_completed)
  }
}

# ==============================================================================
# REDIS PUB/SUB CHANNELS
# ==============================================================================

redis: Redis Pub/Sub {
  style.fill: "#fef3c7"

  feed-channels: Feed Channels {
    style.fill: "#fde68a"
    tooltip: "feed:{feedId}:events"

    channel-pattern: |
      Pattern: feed:{feedId}:events (web feeds only)

      Events:
      - new_entry (feedId, entryId, feedType,
        entry list payload: type/title/author/summary/url/
        publishedAt/fetchedAt/siteName/feedTitle)
      - entry_updated (feedId, entryId, metadata)
    |
  }

  user-channels: User Channels {
    style.fill: "#fde68a"
    tooltip: "user:{userId}:events"

    channel-pattern: |
      Pattern: user:{userId}:events

      Events:
      - new_entry for email and saved entries, entry_updated
        for saved (subscriptionId; feedType, server-side
        only; no feedId)
      - subscription_created (the subscription row + counts)
      - subscription_updated (the subscription row)
      - subscription_deleted (subscriptionId + counts, live path only)
      - entry_state_changed (read/starred + unread counts)
      - tag_created / tag_updated / tag_deleted
      - import_progress (per-feed progress)
      - import_completed (final counts)
    |
  }
}

# ==============================================================================
# SSE BACKEND ENDPOINT
# ==============================================================================

sse-endpoint: SSE Endpoint {
  style.fill: "#f0fdf4"
  tooltip: "src/app/api/v1/events/route.ts"

  subscriber: Shared Redis Subscriber {
    style.fill: "#bbf7d0"
    tooltip: "src/server/redis/pubsub.ts, src/server/realtime/sse-connection.ts"

    description: |
      One Redis connection per process; channel
      subscriptions are reference-counted and messages
      fan out in-process to all SSE connections.

      On connection:
      1. Build feedId → subscriptionId map (web feeds)
      2. Subscribe to user:{userId}:events
      3. Subscribe to feed:{feedId}:events for each web subscription
    |
  }

  message-handler: Message Handler {
    style.fill: "#bbf7d0"
    tooltip: "src/server/realtime/sse-connection.ts"

    transform: |
      Entry Events (new_entry, entry_updated):
      - Web: transform feedId → subscriptionId
      - Email/saved: subscriptionId comes on the user event
      - new_entry: compute this user's absolute unread
        counts (getBulkEntryRelatedCounts) and attach them,
        so the client sets counts directly (idempotent, #892)
      - new_entry: subscriptionIds = [subscriptionId]
        (a new entry's one membership); the entry payload
        carries its type (display only)
      - feedId and feedType stay server-side: neither is sent

      Other User Events:
      - Forward directly
      - On subscription_created (web): subscribe to new feed channel
      - On subscription_deleted: unsubscribe from feed channel
    |
  }

  hello: Hello {
    style.fill: "#bbf7d0"
    first: First event, with the server's build id
  }

  heartbeat: Heartbeat {
    style.fill: "#bbf7d0"
    interval: Every 30 seconds
  }
}

# ==============================================================================
# FRONTEND EVENT HANDLING
# ==============================================================================

frontend: Frontend (useRealtimeUpdates) {
  style.fill: "#fdf4ff"
  tooltip: "src/lib/hooks/useRealtimeUpdates.ts"

  event-source: EventSource {
    style.fill: "#f5d0fe"

    listeners: |
      Named event listeners:
      - hello
      - new_entry
      - entry_updated
      - subscription_created
      - subscription_deleted
      - import_progress
      - import_completed
    |
  }

  handle-event: Event Handler {
    style.fill: "#f5d0fe"
    tooltip: "handleEvent callback"
  }

  polling-fallback: Polling Fallback {
    style.fill: "#e9d5ff"

    description: |
      When SSE unavailable (503):
      - Poll sync.events every 30s
      - Retry SSE every 60s
      - Uses granular cursors per entity type
    |
  }
}

# ==============================================================================
# CACHE UPDATE OPERATIONS
# ==============================================================================

cache-ops: Cache Operations {
  style.fill: "#fff7ed"
  tooltip: "src/lib/cache/operations.ts"

  new-entry-handler: applyUnreadCounts {
    style.fill: "#fed7aa"

    updates: |
      Sets absolute counts from event.counts (no refetch)
      in the local store, keeping each list's newest:
      - stored subscriptions: unreadCount (one the store
        lacks that now has unread entries is fetched when
        a loaded sidebar section may list it)
      - tag and Uncategorized counts (work even when the
        subscription isn't stored, #892)
      - All, Starred, Saved

      Absolute (not delta) and stamped → idempotent: a
      reconnect catch-up sync re-delivering the same
      new_entry can't double-count, and a late one can't
      regress a newer count.

      Stores the event's entry payload in the local
      entry store and inserts it into matching loaded
      lists (addServerEntryToLists): sorted position,
      deduped by ID, placed by its subscriptionIds:
      tag/uncategorized lists through the stored
      subscriptions, Saved through the saved
      subscription's id. Skips search/Recently
      Read lists and entries beyond the loaded
      pagination window.

      Does NOT invalidate entries.list — lists refresh
      on navigation (useEntryListRefreshOnNavigate)
    |
  }

  entry-updated-handler: entry_updated {
    style.fill: "#fed7aa"

    updates: |
      Direct update (metadata from event) to the
      stored entry: title, author, summary, url,
      publishedAt — lists and the reader render it.
    |
  }

  sub-created-handler: handleSubscriptionCreated {
    style.fill: "#fed7aa"

    updates: |
      Structural: write the subscription to the local
      store (the sidebar sections derive from it)

      Counts (live path): set absolute counts from
      event.counts via applyUnreadCounts.
      Sync catch-up path (no counts): invalidate
      tags.list + entries.countLists instead.
    |
  }

  sub-deleted-handler: handleSubscriptionDeleted {
    style.fill: "#fed7aa"

    updates: |
      Structural: remove the subscription from the
      local store

      Counts (live path): set absolute counts from
      event.counts. Sync catch-up path can't recompute
      the former tags → omits counts → invalidate
      tags.list + entries.countLists.

      Always invalidates entries.list.
    |
  }

  import-handlers: import_progress / import_completed {
    style.fill: "#fed7aa"

    updates: |
      import_progress:
      - imports.get({ id }): invalidate
      - imports.list: invalidate

      import_completed:
      - imports.get({ id }): invalidate
      - imports.list: invalidate
      (entry/subscription updates handled by individual events)
    |
  }
}

# ==============================================================================
# CONNECTIONS - Event Sources to Redis
# ==============================================================================

event-sources.entry-processor.new-entry-web -> redis.feed-channels: new_entry {
  style.stroke: "#2563eb"
}
event-sources.entry-processor.entry-updated -> redis.feed-channels: entry_updated {
  style.stroke: "#2563eb"
}
event-sources.email-processor.new-entry-email -> redis.user-channels: new_entry {
  style.stroke: "#7c3aed"
}
event-sources.saved-service.new-saved -> redis.user-channels: new_entry {
  style.stroke: "#7c3aed"
}
event-sources.saved-service.saved-updated -> redis.user-channels: entry_updated {
  style.stroke: "#7c3aed"
}

event-sources.subscriptions-service.sub-created -> redis.user-channels: subscription_created {
  style.stroke: "#7c3aed"
}
event-sources.subscriptions-service.sub-deleted -> redis.user-channels: subscription_deleted {
  style.stroke: "#7c3aed"
}
event-sources.job-handlers.import-sub-created -> redis.user-channels: subscription_created {
  style.stroke: "#7c3aed"
}
event-sources.job-handlers.import-progress -> redis.user-channels: import_progress {
  style.stroke: "#7c3aed"
}
event-sources.job-handlers.import-completed -> redis.user-channels: import_completed {
  style.stroke: "#7c3aed"
}

# ==============================================================================
# CONNECTIONS - Redis to SSE Endpoint
# ==============================================================================

redis.feed-channels -> sse-endpoint.subscriber: Subscribe per-feed {
  style.stroke: "#16a34a"
}
redis.user-channels -> sse-endpoint.subscriber: Subscribe per-user {
  style.stroke: "#16a34a"
}

sse-endpoint.subscriber -> sse-endpoint.message-handler: on("message") {
  style.stroke: "#16a34a"
}

# ==============================================================================
# CONNECTIONS - SSE Endpoint to Frontend
# ==============================================================================

sse-endpoint.message-handler -> frontend.event-source: SSE stream {
  style.stroke: "#c026d3"
  style.stroke-width: 2
}

frontend.event-source -> frontend.handle-event: Named events {
  style.stroke: "#c026d3"
}

# ==============================================================================
# CONNECTIONS - Frontend to Cache Operations
# ==============================================================================

frontend.handle-event -> cache-ops.new-entry-handler: new_entry {
  style.stroke: "#ea580c"
}
frontend.handle-event -> cache-ops.entry-updated-handler: entry_updated {
  style.stroke: "#ea580c"
}
frontend.handle-event -> cache-ops.sub-created-handler: subscription_created {
  style.stroke: "#ea580c"
}
frontend.handle-event -> cache-ops.sub-deleted-handler: subscription_deleted {
  style.stroke: "#ea580c"
}
frontend.handle-event -> cache-ops.import-handlers: import_* {
  style.stroke: "#ea580c"
}

# ==============================================================================
# ENTRY TYPE DIFFERENCES
# ==============================================================================

entry-types: Entry Type Differences {
  style.fill: "#f1f5f9"

  web: web (RSS/Atom) {
    style.fill: "#e2e8f0"
    description: |
      - Published from entry-processor
      - Has subscriptionId
      - Updates subscription + tag unread counts
    |
  }

  email: email (Newsletter) {
    style.fill: "#e2e8f0"
    description: |
      - Published from email inbound processor
      - Has subscriptionId
      - Updates subscription + tag unread counts
    |
  }

  saved: saved (Read-it-later) {
    style.fill: "#e2e8f0"
    description: |
      - Published from saved service/router
      - subscriptionId is NULL (no subscription row)
      - Updates the Saved count
      - Does NOT update subscription/tag counts
    |
  }
}

# ==============================================================================
# CACHE UPDATE STRATEGY NOTES
# ==============================================================================

strategy-notes: Cache Strategy {
  style.fill: "#ecfccb"

  direct-updates: Direct Updates (preferred) {
    style.fill: "#d9f99d"
    description: |
      Surgical updates avoid refetch:
      - Subscription unread counts
      - Tag unread counts
      - Global entry counts
      - Entry read/starred state
      - Subscription list add/remove
    |
  }

  invalidations: Invalidations (force refetch) {
    style.fill: "#d9f99d"
    description: |
      Force refetch when necessary:
      - Entry lists on navigation (pathname change)
      - Import progress (complex state)
    |
  }

  design-rationale: Design Rationale {
    style.fill: "#d9f99d"
    description: |
      entries.list is NOT invalidated on new_entry:
      - The entry is inserted directly into matching
        loaded lists (appears live, no refetch)
      - Unread counts update from the same event
      - Keeps scrolling smooth without flicker
        (browser scroll anchoring for inserts above
        the viewport)
      - Lists refresh on navigation instead
        (useEntryListRefreshOnNavigate)
    |
  }
}
